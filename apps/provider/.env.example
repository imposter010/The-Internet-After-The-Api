HOST=0.0.0.0
PORT=8001
PROVIDER_ADMIN_TOKEN=replace-with-a-long-provider-token
# Only the provider console origins. Never include ShopFlow here.
PROVIDER_CONSOLE_ORIGINS=http://localhost:8001,http://127.0.0.1:8001,http://localhost:5173,http://127.0.0.1:5173
# Browser destinations permitted by the provider panel's Content Security Policy.
PROVIDER_CONNECT_ORIGINS=http://localhost:8001,http://127.0.0.1:8001,http://localhost:5173,http://127.0.0.1:5173
