HOST=0.0.0.0
PORT=8000
MONGODB_URI=mongodb://127.0.0.1:27017/api_phoenix
PROVIDER_URL=http://127.0.0.1:8001
GATEWAY_ADMIN_TOKEN=replace-with-a-long-gateway-token
GATEWAY_DATA_KEY=replace-with-a-stable-separate-fixture-encryption-key
DASHBOARD_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CLIENT_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
UPSTREAM_TIMEOUT_MS=4000
REPAIR_DELAY_MS=700
OBSERVATION_TTL_DAYS=7
# OpenAI drift analyst. Credentials stay on the gateway, never in VITE_* settings.
# A blank key keeps the deterministic demo available. See docs/LLM-GUIDE.md.
LLM_ENABLED=true
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=8000
# Optional full chat-completion endpoint/key override (including local compatible services).
LLM_URL=
LLM_API_KEY=
