HOST=0.0.0.0
PORT=8000
MONGODB_URI=mongodb://127.0.0.1:27017/api_phoenix
PROVIDER_URL=http://127.0.0.1:8001
GATEWAY_ADMIN_TOKEN=replace-with-a-long-gateway-token
GATEWAY_DATA_KEY=replace-with-a-stable-separate-fixture-encryption-key
DASHBOARD_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CLIENT_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
UPSTREAM_TIMEOUT_MS=4000
REPAIR_DELAY_MS=700
OBSERVATION_TTL_DAYS=7
# Groq LLM analyst. For the normal local demo, paste only this key.
# Credentials stay on the gateway, never in VITE_* settings.
LLM_ENABLED=true
GROQ_API_KEY=
LLM_TIMEOUT_MS=8000
# Optional advanced OpenAI-compatible endpoint/model/key overrides.
LLM_URL=
LLM_MODEL=
LLM_API_KEY=
OPENAI_API_KEY=
