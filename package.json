{
  "name": "api-phoenix",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:provider": "npm run dev -w @phoenix/provider",
    "dev:gateway": "npm run dev -w @phoenix/gateway",
    "dev:dashboard": "npm run dev -w @phoenix/console",
    "dev:client": "npm run dev -w @phoenix/shopflow",
    "build": "npm run build -w @phoenix/console && npm run build -w @phoenix/shopflow",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:llm-ui": "playwright test --config playwright.llm.config.js",
    "demo": "node scripts/demo.mjs",
    "mongo:dev": "node scripts/mongo-dev.mjs"
  },
  "dependencies": {
    "@phoenix/shared": "*",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "mongoose": "^8.19.1",
    "socket.io": "^4.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@tailwindcss/vite": "^4.1.13",
    "@vitejs/plugin-react": "^5.0.3",
    "@xyflow/react": "^12.8.5",
    "lucide-react": "^0.468.0",
    "mongodb-memory-server": "^10.2.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.1.4",
    "tailwindcss": "^4.1.13",
    "vite": "^7.1.7",
    "vitest": "^5.0.3"
  }
}
